# Copy to config.local.toml (gitignored), or let `magnum init` write it. Appended to config.toml;
# config.toml.example has every key in a worked setup and `magnum config` validates the result.

[daemon]
default_repo = "example/widgets"   # `magnum review 123` means example/widgets#123

[[identity]]
name = "me"
kind = "gh"                        # your gh login: polls GitHub and, here, posts the reviews
login = "your-login"

[[watch]]
owner = "example"
include = ["widgets"]              # repository globs; ["*"] watches the whole owner
identity = "me"                    # who posts; a GitHub App identity is in config.toml.example
poll_identity = "me"               # who polls: always a gh login
# clone_root = "~/Projects"        # where the clone is found or created; no [[pool]] needed
