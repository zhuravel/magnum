# magnum eval corpus: pull requests with known defects, replayed at a pinned
# head by `magnum eval run` as blind dry runs (nothing is posted). Copy this
# file to eval.local.toml (gitignored) and describe real cases there: a corpus
# names defects in real code, so it never belongs in a public repository.
#
# A case's PR must be in a watched repository with a local clone (the pool's
# main clone, or one under the watch's clone_root); its roles, identity and
# readiness probes are the watch's.

[[case]]
name = "signature-check"                             # [a-z0-9-], unique
pr = "talkable/talkable#1234"                        # owner/repo#N
head = "0123456789abcdef0123456789abcdef01234567"    # the full commit id to review
# base = "master"                                    # the PR's base when GitHub's has changed since
why = "a human reviewer found the missing signature check on this head"

# A defect counts as found when an inline comment of the planned review sits
# on one of `paths` (globs, `**` spans directories), within `lines` (head
# side, 3 lines of slack) when given, and matches one of `match`
# (case-insensitive regular expressions). `body = true` also accepts a
# mention in the review body. `severity` is the weakest one that still counts
# as right. Inline comments that match no defect count as noise;
# a comment whose first line is a simplification heading ("**Simplification**
# (keeps behavior: …)", or an earlier "(optional…)" one) is counted apart.
[[case.defect]]
id = "signature-skip"
title = "The callback accepts requests without verifying their signature"
severity = "P1"
paths = ["app/controllers/**/callbacks_controller.rb"]
lines = [40, 75]
match = ["signature", "hmac", "verif"]

[[case.defect]]
id = "coupon-reuse"
title = "A refunded order's coupon can be applied again"
severity = "P2"
paths = ["app/models/coupon*.rb", "app/services/**/refund*.rb"]
match = ["reus", "twice", "again"]
body = true

# `expect = "absent"` turns a defect around: it is a finding the review must
# not make (the author declined it as wrong). A finding that matches it is a
# false positive, an "absent hit" in the report, and counts neither as noise
# nor in recall. With `severity`, only a finding at that severity or stronger
# is a hit: the point was right but ranked too high, and a weaker finding on
# it is the review getting it right.
[[case.defect]]
id = "nil-guard"
title = "The caller already checks the token: a nil guard is not needed"
expect = "absent"
paths = ["app/controllers/**/callbacks_controller.rb"]
lines = [80, 84]
match = ["nil", "guard"]

# A rendering defect users see is at least P2 (the review skill's section 4):
# a review that finds it but calls it optional (P3) scores it found at the
# wrong severity. Here the PR wraps each date of a settings page in a tooltip
# <span> inside a translation whose key lacks the _html suffix, so the page
# shows the markup as text.
[[case]]
name = "settings-dates-escaped-markup"
pr = "example/example#12"
head = "89abcdef0123456789abcdef0123456789abcdef"
why = "a local review ranked the escaped date markup P3 and the PR shipped with it"

[[case.defect]]
id = "date-markup-escaped"
title = "The settings page shows each date as escaped <span> markup"
severity = "P2"
paths = ["app/views/settings/**", "config/locales/*.yml"]
match = ["escap", "<span", "as text", "html_safe", "_html"]
body = true
